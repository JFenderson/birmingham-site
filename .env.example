# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, never exposed to client; used in src/lib/supabase/admin.ts

# ── Multi-tenant routing ─────────────────────────────────
# Local dev: lvh.me. Testing on the shared Vercel domain before
# birminghamsigmas.org goes live: set this to that project's *.vercel.app
# hostname (e.g. birmingham-site.vercel.app) — non-root chapters can't get
# real subdomains there, so use https://<that-host>/?__tenant=<slug> instead,
# which proxy.ts allows specifically on *.vercel.app even in production.
# Once the real domain is cut over: birminghamsigmas.org.
ROOT_DOMAIN=lvh.me
CHAPTER_SLUG_MAP=                     # JSON string, e.g. {"root":"<uuid>","miles":"<uuid>",...} — regenerate after seeding the chapters table

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://lvh.me:3000

# ── Rate limiting (stubbed Phase 1; real values PHASE 2+) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── PHASE 2+: Square payments ────────────────────────────
SQUARE_ACCESS_TOKEN=
# Not read by any server code today — NEXT_PUBLIC_SQUARE_APP_ID is what the
# client actually uses. Keep this in sync with it if a server-side use of the
# application ID is ever added.
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# "sandbox" or "production" — controls the Square SDK/Web Payments SDK
# environment EXPLICITLY. Deliberately NOT derived from NODE_ENV: Vercel
# preview deploys run with NODE_ENV=production even though they hold sandbox
# credentials, which would otherwise cause every Square call to 401.
# Defaults to "sandbox" if unset.
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# ── PHASE 2+: Resend transactional email ─────────────────
RESEND_API_KEY=
# Optional override for the transactional "from" address. Defaults to
# "notifications@birminghamsigmas.org" (see src/lib/email/config.ts) if unset.
EMAIL_FROM=

# ── PHASE 2+: Vercel Cron (meeting reminders) ────────────
# Vercel attaches this as `Authorization: Bearer $CRON_SECRET` on cron
# invocations of /api/cron/meeting-reminders; the route rejects any other
# caller. Schedule is 14:00 UTC daily — see vercel.json.
CRON_SECRET=

# ── PHASE 2+: Headless CMS — not used yet ────────────────
# SANITY_PROJECT_ID=
# SANITY_DATASET=
# SANITY_API_TOKEN=
